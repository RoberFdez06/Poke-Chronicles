rules_version = '2';
// Reglas de Firestore de Poké Chronicles. OJO: NO se despliegan solas al hacer commit:
//   firebase deploy --only firestore:rules   (lo hace Roberto)
// Modo admin (src/data/admin.ts): NO da permisos de servidor. Es solo comodidad de pruebas en el cliente: el panel
// cambia el guardado propio (users/{uid}), que estas reglas ya dejan escribir a su dueño. No se abre nada más.
// Ningún campo escribible por el cliente concede permisos: las reglas solo miran request.auth.uid.
service cloud.firestore {
  match /databases/{database}/documents {

    // ¿Es el dueño del documento? (sesión iniciada y mismo uid)
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Esquema de users/{uid} (lo escribe src/net/cloud.ts → flush):
    //   { data: map<string,string>, name: string(≤40) | null, updatedAt: hora del servidor }
    // Sin campos extra (nada de "admin", "monedas globales", etc.). Tamaño: Firestore ya limita el documento a
    // 1 MiB; además se limita el número de claves de data (igual que SAVE_LIMITS.maxKeys en src/data/safeData.ts).
    function validUserDoc(d) {
      return d.keys().hasOnly(['data', 'name', 'updatedAt'])
        && d.keys().hasAll(['data', 'updatedAt'])
        && d.data is map
        && d.data.size() <= 2000
        && (!('name' in d) || d.name == null || (d.name is string && d.name.size() <= 40))
        && d.updatedAt == request.time
        && moneyFieldOk(d.data, 'pokeisaac.tickets', 6)
        && moneyFieldOk(d.data, 'pokeisaac.coins', 6)
        && moneyFieldOk(d.data, 'pokeisaac.candies', 7);
    }

    // Tope a las claves numéricas de moneda (tickets, caramelos): nunca se ganan tantos jugando, pero un valor
    // escrito a mano por fuera del juego (API REST, consola) sí podría ponerlos altísimos. No es una validación
    // completa (el resto del guardado sigue sin tipar; eso pediría una función en la nube, de pago) pero sube
    // mucho el listón: de "cualquier número" a "como mucho un número de maxDigits cifras, y solo dígitos".
    function moneyFieldOk(data, key, maxDigits) {
      return !(key in data)
        || (data[key] is string
            && data[key].size() >= 1 && data[key].size() <= maxDigits
            && data[key].matches('^[0-9]+$'));
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUserDoc(request.resource.data);
      allow delete: if isOwner(uid);
    }

    // Subcolecciones de users/{uid}: el juego no las usa → cerradas (antes estaban abiertas al dueño sin esquema)

    // Todo lo demás, cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
