# Copia este archivo a .env.local (no se sube a git) y rellénalo.
# Firebase (ver docs/DESARROLLO.md)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Modo admin (ver docs/BITACORA.md, «Modo admin»): SHA-256 del correo del administrador en minúsculas.
# Vacío = nadie es admin. Nunca pongas aquí el correo en claro.
VITE_ADMIN_EMAIL_SHA256=
